{
  "extends": "@tsconfig/node24/tsconfig.json",

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "removeComments": true
  },

  "include": ["src"]
}
